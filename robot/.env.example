# Copy to robot/.env (git-ignored). Never commit or share robot/.env.
CRM_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase secret key (sb_secret_...): full database access. Keep it on this computer only.
CRM_SERVICE_KEY=
# Optional. Without it the robot reads each lead's website but skips web searches.
FIRECRAWL_API_KEY=
